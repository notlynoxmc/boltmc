{
  "schemaVersion": 1,
  "id": "boltmc",
  "version": "${version}",
  "name": "Bolt Mc",
  "icon": "assets/boltmc/icon.png",
  "description": "3D cosmetics (wings, halo, hats), a recolorable particle aura and a simple friends chat.",
  "environment": "client",
  "mixins": [
    "boltmc.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "dev.boltmc.BoltMcClient"
    ],
    "modmenu": [
      "dev.boltmc.BoltMcModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "recommends": {
    "modmenu": "*"
  }
}